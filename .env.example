# Copy to .env (optional - every variable has a sane default)
PORT=3000
DB_PATH=./data/app.db
SPREADSHEET_ID=1Ucbd4p6l15hKjSUiChBT0KjcLvF2SHcP
# Seed/fallback only. Live discovery reads the real tab list from the
# public sheet, so new weeks (T19, T20...) need NO config change.
SHEET_SOURCES=T01:1201125911
# Auto re-sync every N minutes (0 = disable; use POST /api/sync manually)
SYNC_INTERVAL_MIN=30
# Re-read the worksheet list at most every N minutes (0 = every sync)
DISCOVERY_TTL_MIN=360
